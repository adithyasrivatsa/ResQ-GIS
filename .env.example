# ResQ-GIS Operational Environment Configuration
# Copy this file to .env and configure provider credentials as needed.

# Operating Mode: "demo" (sample datasets) or "live" (government API feeds)
DATA_MODE=demo

# PostgreSQL 16 + PostGIS 3.4 Spatial Database Connection
DATABASE_URL=postgresql://resqgis:resqgis@localhost:5432/resqgis

# Cesium Ion Access Token (Optional: open Sentinel-2, OSM, and Ellipsoid are used if absent)
CESIUM_ION_TOKEN=

# IMD (India Meteorological Department) API
IMD_API_KEY=
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1

# NDMA / SACHET CAP Alert Feed URL
NDMA_CAP_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/FetchAllAlertDetails

# Central Water Commission (CWC) River Gauging API
CWC_API_BASE_URL=

# Optional Redis Cache (Leave empty if running without Redis)
REDIS_URL=

# Frontend Dev Server API target
VITE_API_BASE_URL=http://localhost:8000
