# ResQ-GIS Backend Configuration
# Copy this to .env and fill in values

# Database
DATABASE_URL=postgresql://resqgis:resqgis@localhost:5432/resqgis

# IMD API
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
IMD_API_KEY=

# NDMA / SACHET
NDMA_CAP_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/FetchAllAlertDetails
NDMA_RSS_URL=

# CWC
CWC_API_BASE_URL=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# App
APP_ENV=development
DATA_MODE=live
DEMO_MODE=false

# ISRO Bhuvan / NRSC Geospatial APIs
BHUVAN_WMS_URL=https://bhuvan-wms.nrsc.gov.in/bhuvan/wms
BHUVAN_API_BASE_URL=https://bhuvan-app1.nrsc.gov.in/api
BHUVAN_TOKEN_VILLAGE_GEOCODING=your_bhuvan_village_geocoding_token
BHUVAN_TOKEN_VILLAGE_REVERSE=your_bhuvan_village_reverse_geocoding_token
BHUVAN_TOKEN_ROUTING=your_bhuvan_routing_token
BHUVAN_TOKEN_GEOID=your_bhuvan_geoid_token
BHUVAN_TOKEN_POSTAL_HOSPITAL=your_bhuvan_postal_hospital_token
BHUVAN_TOKEN_LULC_STATS=your_bhuvan_lulc_stats_token
BHUVAN_TOKEN_LULC_AOI=your_bhuvan_lulc_aoi_token
